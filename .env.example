# Copia este archivo como .env y reemplaza cada valor con los datos
# que entrega Firebase Console (Project Settings > General > Your apps).
# El databaseURL aparece en Build > Realtime Database.
VITE_FIREBASE_API_KEY="API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://PROJECT_ID-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="SENDER_ID"
VITE_FIREBASE_APP_ID="APP_ID"
